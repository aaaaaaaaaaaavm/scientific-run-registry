#!/bin/sh
# Local enforcement: git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    python3 tools/prepublish_gate.py --commit "$local_sha"
done
